# Скопируй в .env и правь под свой хост.

# Порт, на котором панель торчит наружу
DOCK_PANEL_PORT=7788

# mock — синтетический хост (докер не нужен, удобно для разработки)
# docker — настоящий демон через /var/run/docker.sock
DOCK_DRIVER=docker

# Корень, куда ложатся тома сервисов. Значение поля «том» в панели
# ('dock/gitea') считается относительно него: /srv/dock/gitea
DOCK_HOST_VOLUME_ROOT=/srv

# С какой точки монтирования считается свободное место на экране сервисов
DOCK_HOST_ROOT=/

# Docker-сеть для контейнеров, поднятых панелью
DOCK_NETWORK=dock

# Показывать ли контейнеры, созданные не через dock
DOCK_ADOPT_FOREIGN=true

# Как часто пересчитываются метрики, мс
DOCK_POLL_INTERVAL=4000

LOG_LEVEL=info
