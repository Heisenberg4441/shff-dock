# Копировать в .env необязательно — значения по умолчанию рабочие.

# Порт, на котором панель торчит наружу
DOCK_PANEL_PORT=7788

# mock — синтетический хост (докер не нужен, удобно для разработки)
# docker — настоящий демон через /var/run/docker.sock
DOCK_DRIVER=docker

# Корень раскладки. Здесь появятся stacks/, registry/, backups/ и dock.yml.
# Путь обязан совпадать внутри контейнера и снаружи.
DOCK_ROOT=/home/dock

# Docker-сеть, общая для панели и поднятых ею стеков
DOCK_NETWORK=dock

# Показывать ли контейнеры, поднятые не через dock
DOCK_ADOPT_FOREIGN=true

# Под каким uid:gid создавать каталоги данных стеков
DOCK_PUID=1000
DOCK_PGID=1000

# Репозиторий с готовыми стеками — в образе их нет. По умолчанию берётся
# https://raw.githubusercontent.com/Heisenberg4441/shff-registry/master
# Значение off выключает удалённый реестр: тогда работает только тот, что
# указан в DOCK_BUNDLED_REGISTRY.
# DOCK_REGISTRY_URL=https://raw.githubusercontent.com/youruser/your-stacks/master

# Как часто перечитывать реестр, минуты. 0 — только при старте и по кнопке.
DOCK_REGISTRY_TTL=60

# Имя хоста, часовой пояс и оператор. Пусто — панель определяет их по хосту
# (/etc/hostname, /etc/timezone или /etc/localtime, /etc/passwd по DOCK_PUID).
# Задавать стоит, только если автоопределение промахнулось.
# DOCK_HOSTNAME=nas
# DOCK_TZ=Europe/Moscow
# DOCK_OPERATOR=misha

# Как часто пересчитываются метрики, мс
DOCK_POLL_INTERVAL=4000

LOG_LEVEL=info
