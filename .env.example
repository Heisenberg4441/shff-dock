# Копировать в .env необязательно — значения по умолчанию рабочие.

# Порт, на котором панель торчит наружу
DOCK_PANEL_PORT=7788

# mock — синтетический хост (докер не нужен, удобно для разработки)
# docker — настоящий демон через /var/run/docker.sock
DOCK_DRIVER=docker

# Корень раскладки. Здесь появятся stacks/, registry/, backups/ и dock.yml.
# Путь обязан совпадать внутри контейнера и снаружи.
DOCK_ROOT=/home/dock

# Docker-сеть, общая для панели и поднятых ею стеков
DOCK_NETWORK=dock

# Показывать ли контейнеры, поднятые не через dock
DOCK_ADOPT_FOREIGN=true

# Под каким uid:gid создавать каталоги данных стеков
DOCK_PUID=1000
DOCK_PGID=1000

# Репозиторий с готовыми стеками. Пусто — панель живёт на реестре из образа.
# DOCK_REGISTRY_URL=https://raw.githubusercontent.com/youruser/dock-stacks/main

# Как часто пересчитываются метрики, мс
DOCK_POLL_INTERVAL=4000

LOG_LEVEL=info
